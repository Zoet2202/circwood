# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Office lock / temp files
~$*

# Papers / reports — never commit PDFs, the repo is public
*.pdf

# Verbatim SSB API responses — a debugging/diffing cache regenerated by every
# fresh run, not an input. Committed test fixtures live in tests/fixtures/ssb/.
data/raw/ssb/

# Static-site data bundle — generated from the committed CSVs by
# `circwood-bundle` (locally and in the deploy workflow), never committed:
# the CSVs are the canonical artifact and one committed copy is enough.
site/data/

# OS
.DS_Store
Thumbs.db

# Tooling
.claude/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Streamlit
.streamlit/secrets.toml
